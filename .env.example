# Copy to .env and fill in from https://developer.yahoo.com/apps/
# Create a Confidential Client app with redirect URI "https://localhost:8501/". Prefer .env.template + op run.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Optional: skip the league picker by naming the league key directly, e.g. 461.l.123456
YAHOO_LEAGUE_KEY=
